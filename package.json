{
    "name": "ship-shape",
    "version": "0.1.0",
    "description": "Procedural Canvas 2D ship, greeble, and railway generators.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./greebles": {
            "types": "./dist/greebles/index.d.ts",
            "import": "./dist/greebles/index.js"
        },
        "./capitalships": {
            "types": "./dist/capitalships/index.d.ts",
            "import": "./dist/capitalships/index.js"
        },
        "./railway": {
            "types": "./dist/railway/index.d.ts",
            "import": "./dist/railway/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "test": "tsc -p tsconfig.tests.json && node --test dist/tests/*.test.js",
        "build-and-test": "npm run clean && npm run build && npm test",
        "build": "tsc",
        "lint": "eslint .",
        "dev": "vite",
        "generate:legibility": "node scripts/generate-legibility-artifacts.mjs",
        "check:legibility": "node scripts/generate-legibility-artifacts.mjs --check"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/node": ">=26.1.0",
        "@typescript-eslint/eslint-plugin": ">=8.62.1",
        "@typescript-eslint/parser": ">=8.62.1",
        "eslint": ">=10.6.0",
        "playwright": ">=1.61.1",
        "typescript": ">=6.0.3",
        "vite": ">=8.1.3"
    }
}
