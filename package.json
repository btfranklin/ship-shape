{
    "name": "ship-shape",
    "version": "0.1.0",
    "description": "Procedural Canvas 2D capital ship and greeble generators.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./greebles": {
            "types": "./dist/greebles/index.d.ts",
            "import": "./dist/greebles/index.js"
        },
        "./capitalships": {
            "types": "./dist/capitalships/index.d.ts",
            "import": "./dist/capitalships/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rm -rf dist dist-tests",
        "test": "npm run clean && tsc -p tsconfig.tests.json && node --test dist-tests/tests/*.test.js && node --test tests/legibility-generator.test.mjs",
        "test:package": "node scripts/verify-package.mjs",
        "test:browser": "node --test tests/browser-rendering.test.mjs",
        "validate": "npm run lint && npm run typecheck:playgrounds && npm run test && npm run test:package && npm run test:browser && npm run check:legibility && npm audit --audit-level=high",
        "build": "tsc",
        "lint": "eslint .",
        "typecheck:playgrounds": "tsc -p tsconfig.playgrounds.json",
        "dev": "vite",
        "generate:legibility": "node scripts/generate-legibility-artifacts.mjs",
        "check:legibility": "node scripts/generate-legibility-artifacts.mjs --check",
        "prepack": "npm run clean && npm run build"
    },
    "keywords": [
        "canvas",
        "procedural-generation",
        "spaceships",
        "greebles",
        "typescript"
    ],
    "author": "B.T. Franklin",
    "license": "MIT",
    "devDependencies": {
        "@napi-rs/canvas": ">=1.0.10",
        "@types/node": ">=26.1.0",
        "@typescript-eslint/eslint-plugin": ">=8.62.1",
        "@typescript-eslint/parser": ">=8.62.1",
        "eslint": ">=10.6.0",
        "playwright": ">=1.61.1",
        "typescript": ">=6.0.3",
        "vite": ">=8.1.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/btfranklin/ship-shape.git"
    },
    "homepage": "https://github.com/btfranklin/ship-shape#readme",
    "bugs": {
        "url": "https://github.com/btfranklin/ship-shape/issues"
    }
}
